#!/usr/bin/env python3
"""
Medical Monitor - unified ckb-next animation.

Simulates a hospital bedside monitor showing several patient vitals across
different keyboard zones, with a defibrillator state machine triggered by
typing inactivity.

Copyright (c) 2026 Preston A. Elder <prez@neuromancy.net>.
Licensed under the MIT License -- see the LICENSE file in the project
repository for the full text.

Designed and refined by Preston A. Elder <prez@neuromancy.net>.
Code authored by Claude AI under Preston's direction.

Tested on a Corsair K70. Zone layouts (especially the numpad and media
keys) assume that hardware; other ckb-next-supported keyboards should
work but visuals may not line up exactly.

Zones:
  * Main keyboard (caps -> enter)        -- ECG sinus rhythm trace
  * Numpad                                -- Pulse-ox plethysmograph
  * Nav cluster (prtscn..pgdn)            -- Respiratory rate (slow breathing)
  * Media keys (stop/prev/play/next)      -- Defibrillator charge bar

States:
  NORMAL    -- default. ECG sinus rhythm, pulse-ox, slow breathing.
  STRESSED  -- triggered by recent typing. ECG goes vfib (random forward
               path), breathing speeds up, pulse-ox stays on. Per-key
               red flash on each keypress.
  CHARGING  -- after `defib_idle` seconds idle. ECG flatlines. Pulse-ox
               replaced by static X on numpad. Breathing stops (apnea).
               Media keys progressively light up over `defib_charge`
               seconds. Aborted if user types again.
  FLATLINE  -- brief pause after charge complete, before flash sequence.
  FLASH/GAP -- discharge sequence: FLASH1 (0.15s) -> GAP1 (1.0s) ->
               FLASH2 (0.15s) -> GAP2 (0.2s) -> FLASH3 (0.15s).
               Whole keyboard goes red.
  RECOVERY  -- snap back to NORMAL after FLASH3.

Parameters:
  bpm                Normal heart rate (BPM, default 60 = 1 beat/sec)
  vfib_bpm           Heart rate during vfib/STRESSED (default 150)
  tracecolor         Trace color for all waveforms (default ffffffff)
  flashcolor         Discharge flash color (default ffff0000, full red)
  stressed           Bool, enable STRESSED state on typing (default 1)
  defib_idle         Sec idle before defib charge starts (default 2.0,
                     0 disables defib entirely)
  defib_charge       Sec to charge across all 4 media keys (default 8.0)
  breathing_normal   Breath cycle duration in NORMAL (sec, default 4.0)
  breathing_stressed Breath cycle duration in STRESSED (sec, default 1.5)

Install:
  Drop this file (executable) into your user-local ckb-next animations
  directory, then have the GUI re-scan its scripts. No sudo, no daemon
  restart, no GUI restart needed:

    mkdir -p ~/.local/share/ckb-next/animations
    cp medical-monitor ~/.local/share/ckb-next/animations/
    chmod +x ~/.local/share/ckb-next/animations/medical-monitor

  Then in ckb-next: Settings -> Animation Scripts -> Re-scan. The
  animation appears in the Lighting tab as "Medical Monitor".

  In the animation's Properties -> Settings -> Playback:
    * Enable "Start with mode" so the animation runs whenever the mode
      is active.
    * Enable "Start with key press" with "on pressed key" selected.
      This is what delivers per-key events to the script and is
      REQUIRED for the per-key red flashes, the STRESSED state,
      and the "abort defib charge by typing" behavior.
"""
import sys
import math
import os
import random
import time as _time


# === Debug logging =========================================================

_DEBUG_LOG = None
_DEBUG_FRAME_COUNT = 0
_DEBUG_LOG_PATH = "/tmp/ckb-ekg-debug.log"


def dbg(msg):
    global _DEBUG_LOG
    if _DEBUG_LOG is None:
        try:
            _DEBUG_LOG = open(_DEBUG_LOG_PATH, "a")
            _DEBUG_LOG.write(f"\n=== Medical Monitor started "
                             f"pid={os.getpid()} uid={os.getuid()} "
                             f"time={_time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")
            _DEBUG_LOG.flush()
        except Exception:
            return
    try:
        _DEBUG_LOG.write(msg + "\n")
        _DEBUG_LOG.flush()
    except Exception:
        pass


# === Protocol helpers ======================================================

def _need_encode(c):
    o = ord(c)
    return (o <= 0x2C or o == 0x2F or 0x3A <= o <= 0x40
            or o == 0x5B or o == 0x5D or o >= 0x7F)


def url_encode(s):
    out = []
    for c in s:
        if _need_encode(c):
            out.append("%{:02X}".format(ord(c)))
        else:
            out.append(c)
    return "".join(out)


def url_decode(s):
    out, i = [], 0
    while i < len(s):
        if s[i] == "%" and i + 2 < len(s):
            try:
                out.append(chr(int(s[i + 1:i + 3], 16)))
                i += 3
                continue
            except ValueError:
                pass
        out.append(s[i])
        i += 1
    return "".join(out)


def read_words():
    line = sys.stdin.readline()
    if not line:
        return ("", "", "")
    parts = line.strip().split(None, 2)
    while len(parts) < 3:
        parts.append("")
    return (url_decode(parts[0]), url_decode(parts[1]), url_decode(parts[2]))


def emit(s): sys.stdout.write(s)
def emit_line(s): sys.stdout.write(s + "\n")
def flush(): sys.stdout.flush()


def _parse_argb(value):
    if len(value) >= 8:
        return (int(value[0:2], 16), int(value[2:4], 16),
                int(value[4:6], 16), int(value[6:8], 16))
    raise ValueError(value)


