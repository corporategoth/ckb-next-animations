#!/usr/bin/env python3
"""ckb-mode-on-lock -- switch ckb-next mode on screen lock/unlock.

Copyright (c) 2026 Preston A. Elder <prez@neuromancy.net>.
Licensed under the MIT License -- see LICENSE in the project repository.

Designed and refined by Preston A. Elder.
Code authored by Claude AI under Preston's direction.

Listens for the freedesktop / GNOME ScreenSaver D-Bus signal on the user
session bus and switches ckb-next's active mode (and optionally profile)
when the screen locks or unlocks. Cross-DE: KDE Plasma, GNOME, XFCE,
Cinnamon, MATE, ...

Mode and profile switching is delegated to the `ckb-next` CLI:
    ckb-next --mode <name>        # switch mode in current profile
    ckb-next --profile <name>     # switch profile (all devices)
so any name that works in the GUI works here -- no Qt-config parsing.

Each side (locked / unlocked) accepts either a single mode name or a
comma-separated list. With 2+ modes, the script picks one per
lock/unlock event using the configured strategy:
    random        pick uniformly at random; never repeats the
                  immediately previous pick when 2+ modes are listed
    round_robin   cycle through the list in order

----------------------------------------------------------------------
Configuration sources -- highest priority first:

  1. Environment variables (set by the systemd unit or your shell):
       CKB_LOCK_MODE_UNLOCKED          mode name (or comma list)
       CKB_LOCK_MODE_LOCKED            mode name (or comma list)
       CKB_LOCK_STRATEGY_UNLOCKED      "random" or "round_robin"
       CKB_LOCK_STRATEGY_LOCKED        "random" or "round_robin"
       CKB_LOCK_PROFILE                profile name, or "none"

  2. Config file at $XDG_CONFIG_HOME/ckb-next/lock.conf (default
     ~/.config/ckb-next/lock.conf, alongside ckb-next-gui's own
     ckb-next.conf):
       mode_unlocked     = EKG
       mode_locked       = BrickBreaker, Snake, Wave
       strategy_locked   = random           # or round_robin
       strategy_unlocked = random
       profile           = none
     Lines starting with `#` are comments. Values may be quoted.

  3. The defaults in the CONFIG block below.

Values are passed verbatim to `ckb-next` as a mode/profile name. Set
a mode value to `none` (or leave it unset) to skip that switch.
----------------------------------------------------------------------
"""

import os
import random
import subprocess
import sys
from pathlib import Path


# === CONFIG ================================================================
# Edit in place, or override via the config file / env vars described in
# the module docstring above. Mode values can be a single name or a
# comma-separated list; with 2+ entries the corresponding strategy
# decides which one is applied per lock/unlock event.
MODE_UNLOCKED     = "EKG"             # mode name, comma list, or None
MODE_LOCKED       = "BrickBreaker"    # mode name, comma list, or None
PROFILE           = None              # profile name, or None
STRATEGY_UNLOCKED = "random"          # "random" or "round_robin"
STRATEGY_LOCKED   = "random"          # "random" or "round_robin"
# ===========================================================================


CKB_NEXT_BIN = "ckb-next"


def log(msg):
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


def warn(msg):
    sys.stderr.write(f"ckb-mode-on-lock: {msg}\n")
    sys.stderr.flush()


# === Config loading ========================================================

def _xdg_config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"))


def _strip_quotes(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s


def _norm(value):
    """'none' / '' -> None; otherwise -> str. Strips surrounding quotes."""
    if value is None:
        return None
    s = value if isinstance(value, str) else str(value)
    s = s.strip()
    if s == "" or s.lower() == "none":
        return None
    return _strip_quotes(s)


def _parse_modes(value):
    """Parse a single mode name or a comma-separated list into [str, ...].
    Empty string, None, and tokens equal to 'none' are dropped (so a
    list like 'EKG, none, Snake' yields ['EKG', 'Snake'] -- handy when
    a env override means to disable one entry of an inherited list)."""
    if value is None:
        return []
    s = value if isinstance(value, str) else str(value)
    out = []
    for raw in s.split(","):
        token = _strip_quotes(raw.strip())
        if token and token.lower() != "none":
            out.append(token)
    return out


_STRATEGY_ALIASES = {
    "random": "random", "rand": "random", "shuffle": "random",
    "round_robin": "round_robin", "round-robin": "round_robin",
    "roundrobin": "round_robin", "rr": "round_robin", "cycle": "round_robin",
}


def _parse_strategy(value, default="random"):
    """Normalize a strategy name. Unknown / empty values fall back to
    `default` (and warn so config typos don't fail silently)."""
    if value is None:
        return default
    s = str(value).strip().lower()
    if not s:
        return default
    if s in _STRATEGY_ALIASES:
        return _STRATEGY_ALIASES[s]
    warn(f"unknown strategy {value!r}; falling back to {default!r}")
    return default


def _load_config_file():
    """Return dict of overrides from lock.conf, or {} if absent."""
    path = _xdg_config_home() / "ckb-next" / "lock.conf"
    if not path.is_file():
        return {}
    out = {}
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.split("#", 1)[0].strip()
        if "=" not in line:
            continue
        key, _, val = line.partition("=")
        out[key.strip().lower()] = val.strip()
    return out


def apply_overrides():
    """Mutate module-level config from env / file."""
    global MODE_UNLOCKED, MODE_LOCKED, PROFILE
    global STRATEGY_UNLOCKED, STRATEGY_LOCKED
    file_cfg = _load_config_file()

    def raw_pick(env_name, file_key, current):
        """Return the raw string value (not normalized) from the
        highest-priority source that defines this setting, or
        `current` if neither env nor file does."""
        if env_name in os.environ:
            return os.environ[env_name]
        if file_key in file_cfg:
            return file_cfg[file_key]
        return current

    # Mode lists stay as raw strings here -- _parse_modes splits later
    # in main(). _norm here would fold a "none" entry to None, which
    # would round-trip badly through the comma-list parser.
    MODE_UNLOCKED = raw_pick("CKB_LOCK_MODE_UNLOCKED", "mode_unlocked",
                             MODE_UNLOCKED)
    MODE_LOCKED   = raw_pick("CKB_LOCK_MODE_LOCKED",   "mode_locked",
                             MODE_LOCKED)
    PROFILE       = _norm(raw_pick("CKB_LOCK_PROFILE", "profile", PROFILE))
    STRATEGY_UNLOCKED = _parse_strategy(
        raw_pick("CKB_LOCK_STRATEGY_UNLOCKED",
                 "strategy_unlocked", STRATEGY_UNLOCKED),
        default="random")
    STRATEGY_LOCKED = _parse_strategy(
        raw_pick("CKB_LOCK_STRATEGY_LOCKED",
                 "strategy_locked", STRATEGY_LOCKED),
        default="random")


# === Mode picker ===========================================================

class ModePicker:
    """Holds a list of mode names and yields one per `pick()` call.

    With 0 modes pick() returns None (skip the switch). With exactly
    1 mode pick() always returns it. With 2+ modes the strategy
    decides:
      * round_robin -- cycle through the list in declared order
      * random      -- uniform random, but never repeat the immediately
                       preceding pick (keeps the same mode from coming
                       up twice in a row, which would produce no
                       visible change on the keyboard)."""

    def __init__(self, modes, strategy):
        self.modes = list(modes)
        self.strategy = strategy
        self.rr_idx = 0
        self.last_pick = None

    def pick(self):
        if not self.modes:
            return None
        if len(self.modes) == 1:
            self.last_pick = self.modes[0]
            return self.modes[0]
        if self.strategy == "round_robin":
            mode = self.modes[self.rr_idx]
            self.rr_idx = (self.rr_idx + 1) % len(self.modes)
        else:
            choices = [m for m in self.modes if m != self.last_pick]
            if not choices:
                choices = self.modes
            mode = random.choice(choices)
        self.last_pick = mode
        return mode

    def describe(self):
        if not self.modes:
            return "<no modes>"
        if len(self.modes) == 1:
            return repr(self.modes[0])
        return "{} of {}".format(self.strategy, self.modes)


# === Talking to ckb-next ==================================================

def _run_ckb(*args):
    log(f"-> {CKB_NEXT_BIN} {' '.join(args)}")
    try:
        subprocess.run([CKB_NEXT_BIN, *args], check=False)
    except FileNotFoundError:
        warn(f"{CKB_NEXT_BIN!r} not on PATH; cannot switch mode/profile")


def switch(mode):
    if PROFILE is not None:
        _run_ckb("--profile", PROFILE)
    if mode is not None:
        _run_ckb("--mode", mode)


# === Lock-event loop ======================================================

DBUS_RULES = (
    "type='signal',interface='org.freedesktop.ScreenSaver',member='ActiveChanged'",
    "type='signal',interface='org.gnome.ScreenSaver',member='ActiveChanged'",
)


def event_loop(on_lock, on_unlock, initial_state="unlocked"):
    """Block on dbus-monitor; dispatch on_lock/on_unlock per signal.

    Some sessions emit both the freedesktop and GNOME ScreenSaver signals
    for the same lock event. We dedup by state, not by time: ignore any
    signal whose new state matches the last one we acted on. A real
    lock-then-unlock toggles state and always fires; a duplicate signal
    keeps the state, so it gets dropped.
    """
    proc = subprocess.Popen(
        ["dbus-monitor", "--session", *DBUS_RULES],
        stdout=subprocess.PIPE, text=True, bufsize=1,
    )
    last_state = initial_state
    try:
        for line in proc.stdout:
            if "boolean true" in line:
                state, action = "locked", on_lock
            elif "boolean false" in line:
                state, action = "unlocked", on_unlock
            else:
                continue
            if state == last_state:
                continue
            last_state = state
            action()
    finally:
        proc.terminate()


def main():
    apply_overrides()
    unlocked = ModePicker(_parse_modes(MODE_UNLOCKED), STRATEGY_UNLOCKED)
    locked   = ModePicker(_parse_modes(MODE_LOCKED),   STRATEGY_LOCKED)
    log(f"ckb-mode-on-lock starting "
        f"(unlocked={unlocked.describe()}, locked={locked.describe()}, "
        f"profile={PROFILE!r})")

    # Initial state: assume unlocked. The next ActiveChanged event will
    # correct it if the screen happens to be locked when we start.
    log("Screen UNLOCKED (initial)")
    switch(unlocked.pick())

    def on_lock():
        mode = locked.pick()
        log(f"Screen LOCKED -> {mode!r}")
        switch(mode)

    def on_unlock():
        mode = unlocked.pick()
        log(f"Screen UNLOCKED -> {mode!r}")
        switch(mode)

    event_loop(on_lock, on_unlock)


if __name__ == "__main__":
    main()
